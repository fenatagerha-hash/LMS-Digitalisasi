        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "trainingId", "userId", "userName", "status", "startingLevel", "currentLevel", "assessmentScore", "overallProgress", "certificateNumber", "enrolledAt", "updatedAt"]
    },
