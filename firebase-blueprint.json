{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Private user account profile containing PII and assigned LMS role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "instansi": { "type": "string", "maxLength": 160 },
        "npsn": { "type": "string", "maxLength": 16, "pattern": "^[0-9]*$" },
        "kabupatenKota": { "type": "string", "maxLength": 120 },
        "jabatan": { "type": "string", "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin_kegiatan", "fasilitator", "peserta", "pemantau"]
        },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "role", "isActive", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Non-PII directory record for displaying participant and facilitator names.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin_kegiatan", "fasilitator", "peserta", "pemantau"]
        },
        "instansi": { "type": "string", "maxLength": 160 },
        "kabupatenKota": { "type": "string", "maxLength": 120 },
        "isActive": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "isActive", "isPublic", "createdAt", "updatedAt"]
    },
    "TrainingProgram": {
      "title": "TrainingProgram",
      "description": "Training activity container with isolated levels, materials, assessments, and score ranges.",
