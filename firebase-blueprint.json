        "signerTitle": { "type": "string", "maxLength": 160 },
        "visibility": { "type": "string", "enum": ["public_catalog", "restricted"] },
        "usesSamrLevels": { "type": "boolean" },
        "progressionPolicy": { "type": "string", "enum": ["sequential", "assigned_only"] },
        "guidelines": { "type": "string", "maxLength": 3000 },
