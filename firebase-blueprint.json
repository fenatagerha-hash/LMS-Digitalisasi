        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "name", "organizer", "startDate", "endDate", "quota", "status", "requireApproval", "visibility", "createdBy", "createdAt", "updatedAt"]
    },
    "TrainingEnrollment": {
      "title": "TrainingEnrollment",
